; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Pixel Core"
run/main_scene="res://test/test_scene.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[input]

attack={
"deadzone": 0.2,
"events": []
}

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[shader_globals]

iso_ambient_color={
"type": "color",
"value": Color(0.12, 0.13, 0.18, 1)
}
iso_ambient_energy={
"type": "float",
"value": 1.0
}
iso_yaw_rot={
"type": "vec2",
"value": Vector2(0, 1)
}
iso_cos_elevation={
"type": "float",
"value": 0.8660254
}
iso_sin_elevation={
"type": "float",
"value": 0.5
}
iso_terminator_low={
"type": "float",
"value": 0.35
}
iso_terminator_high={
"type": "float",
"value": 0.45
}
iso_rim_power={
"type": "float",
"value": 2.0
}
iso_rim_strength={
"type": "float",
"value": 1.0
}
iso_specular_shininess={
"type": "float",
"value": 24.0
}
iso_specular_strength={
"type": "float",
"value": 0.5
}
iso_height_falloff={
"type": "float",
"value": 0.0
}
iso_shadow_strength={
"type": "float",
"value": 1.0
}
iso_shadow_softness={
"type": "float",
"value": 10.0
}
iso_shadow_max_length={
"type": "float",
"value": 192.0
}
